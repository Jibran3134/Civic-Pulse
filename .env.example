# Database
POSTGRES_PASSWORD=postgres

# Redis
# REDIS_URL=redis://redis:6379/0

# AI Provider: llm (Groq), ollama (local), rules (keyword fallback), simulated (CI/tests)
# Canonical values per §2.5: llm | ollama | rules | simulated
TRIAGE_PROVIDER=simulated
GROQ_API_KEY=

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=5

# Cache
STATS_CACHE_TTL=30

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development